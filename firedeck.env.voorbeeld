# Kopieer naar /etc/firedeck.env, vul in, en zet de rechten op 600.
# Dit bestand hoort NIET in git: er staan sleutels in.

FIREDECK_PORT=8090

# Gedeeld wachtwoord voor de toegangspagina. Hoofdletterongevoelig.
FIREDECK_PASS=verander-dit

# Tweede wachtwoord dat ook /mesh vrijgeeft. Hoofdlettergevoelig.
# Leeg laten = /mesh blijft voor iedereen dicht.
FIREDECK_ADMIN_PASS=

# beheer = /mesh alleen met het tweede wachtwoord; open = voor elke bezoeker.
FIREDECK_MESH=beheer

# echt = /send gaat werkelijk de lucht in; sim = wel opbouwen, niet zenden.
# Staat de site publiek, dan is sim het verstandige antwoord.
FIREDECK_SEND=sim

# Waar de openHop-API luistert, en het adminwachtwoord ervan.
OPENHOP_URL=http://127.0.0.1:8000
OPENHOP_PASS=
